rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funciones base de verificación
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isAuthenticated() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    // ==========================================
    // 1. REGLAS PARA ATLETAS (ANONIMIZACIÓN LOPDP)
    // ==========================================
    match /athletes/{dni_hash} {
      // El Admin accede a todo. El Coach ve si coincide con su categoría.
      // El Padre accede SOLO si el hash del menor está vinculado en su token de acceso.
      allow read: if isAdmin() || 
                  (hasRole('coach') && resource.data.category == request.auth.token.category) ||
                  (hasRole('parent') && dni_hash in request.auth.token.tutees);
      
      allow write: if isAdmin();
    }

    // ==========================================
    // 2. BÓVEDA FAMILIAR Y CONSENTIMIENTOS (DERECHOS ARCO)
    // ==========================================
    match /consents/{parent_uid} {
      // Un padre solo gestiona y revoca sus propios consentimientos
      allow read, write: if isAuthenticated() && (request.auth.uid == parent_uid || isAdmin());
    }

    // Historial de accesos para auditorías LOPDP
    match /audit_logs/{log_id} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    // ==========================================
    // 3. ASISTENCIAS (SOPORTE PARA OFFLINE SYNC)
    // ==========================================
    match /attendance_logs/{log_id} {
      // Permite la carga masiva diferida generada por el OfflineSyncService del Coach
      allow create: if hasRole('coach') || isAdmin();
      allow read: if isAdmin() || (hasRole('coach') && resource.data.coach_id == request.auth.uid);
    }

    // ==========================================
    // 4. BLOQUEO GLOBAL (MAINTENANCE MODE)
    // ==========================================
    match /core_config/global {
      // Lectura pública para que la app móvil verifique el estado antes del login. Escritura solo Admin.
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
