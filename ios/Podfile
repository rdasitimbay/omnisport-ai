# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  inhibit_all_warnings!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    target.build_configurations.each do |config|
      # 1. Desactiva el error de las comillas dobles (Soluciona los 13 errores actuales)
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      config.build_settings['WARNING_CFLAGS'] ||= ['$(inherited)']
      config.build_settings['WARNING_CFLAGS'] << '-Wno-quoted-include-in-framework-header'
      
      # 2. Asegura compatibilidad con el estándar C++ actual
      config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
      
      # 3. Corrige el Deployment Target para evitar advertencias de versiones viejas
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'

      # 3b. FIX CRÍTICO XCODE 16: Desactivar el verificador de módulos de Clang
      # Evita que el compilador aísle los encabezados de los Pods y falle al no heredar los paths de Flutter.
      config.build_settings['CLANG_ENABLE_MODULE_VERIFIER'] = 'NO'

      # 4. Genera dSYM para todos los pods (evita warning "Upload Symbols Failed" de gRPC/Firestore)
      config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'

      # 5. Deshabilita firma de código SOLO para el SDK del simulador
      #    (en dispositivo físico la firma la hereda del app principal)
      config.build_settings['CODE_SIGNING_ALLOWED[sdk=iphonesimulator*]'] = 'NO'
      config.build_settings['CODE_SIGNING_REQUIRED[sdk=iphonesimulator*]'] = 'NO'
      config.build_settings['CODE_SIGN_IDENTITY[sdk=iphonesimulator*]'] = '-'

      # 6. FIX CRÍTICO: Desactivar optimización de Swift para FirebaseFunctions
      # Evita el bug (swift_Concurrency_fatalError) del compilador de Xcode 26.4 / Swift 6.3 
      # en la gestión de memoria de 'async let' en compilaciones Release/Profile.
      if target.name == 'FirebaseFunctions' || target.name == 'cloud_functions'
        config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone'
      end
    end
  end
end
